# Optional — leave blank for a fully offline / local-only install.

# Google Drive backup (client-side OAuth only — never required).
# Create a Web application OAuth client, enable Drive API, then either:
#   • paste the Client ID in Dashboard → Data & privacy, or
#   • set it here for a build-time default.
# See docs/DRIVE.md
PUBLIC_GOOGLE_CLIENT_ID=

# Legacy / dormant Supabase paths (not used by the local-first product).
# Keep empty unless you are explicitly reviving cloud sync.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
