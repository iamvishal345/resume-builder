# Optional cloud sync — after creating a Supabase project with Google OAuth enabled:
#   1. Enable auth provider "Google" and set the redirect URL to your origin + "/resumes"
#   2. Create a `resumes` table: id uuid pk default gen_random_uuid(), user_id uuid references auth.users, data jsonb, updated_at timestamptz
#   3. Add a unique index on user_id (the UI upserts onConflict: user_id)
PUBLIC_SUPABASE_URL=
