---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { SITE } from "../data/site";
---

<MarketingLayout
  title="Contact"
  description={`Get in touch with ${SITE.name} - Offline Resume Builder.`}
  ogType="article"
  canonical={`${SITE.url}/contact`}
>
  <section class="page">
    <h1>Contact</h1>
    <p class="lede">
      Found a bug, have an idea, or just want to say hi? We'd love to hear
      from you.
    </p>

    <div class="prose">
      <h2>Best way to reach me</h2>
      <ul>
        <li>
          Email: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </li>
        <li>
          Issues, bugs &amp; feature requests: same address — please include
          steps to reproduce and what you expected.
        </li>
      </ul>

      <h2>Before you write</h2>
      <p>
        Because everything runs locally, we can't see your resumes or your
        browser data. When reporting an issue, please share steps to reproduce
        and what you expected to happen, rather than pasting personal resume
        content.
      </p>
    </div>
  </section>
</MarketingLayout>