---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { SITE } from "../data/site";

const values = [
  { key: "marketing.about.values.offline", label: "Offline first" },
  { key: "marketing.about.values.ads", label: "No ads" },
  { key: "marketing.about.values.trackers", label: "No trackers" },
  { key: "marketing.about.values.account", label: "No account" },
  { key: "marketing.about.values.exports", label: "No paid exports" },
];
---

<MarketingLayout
  title="About & Support"
  description={`About and support for ${SITE.name} — Offline Resume Builder built by ${SITE.ownerName}. Offline-first, no ads, no trackers, and your data stays on your device.`}
  ogType="article"
  titleKey="marketing.about.metaTitle"
  descriptionKey="marketing.about.metaDescription"
  ogTitleKey="marketing.about.metaTitle"
  ogDescriptionKey="marketing.about.metaDescription"
  i18nVars={{ name: SITE.name, owner: SITE.ownerName }}
>
  <section class="page">
    <h1 data-i18n="marketing.about.title">About &amp; Support</h1>
    <p
      class="lede"
      data-i18n="marketing.about.lede"
      data-i18n-vars={JSON.stringify({ owner: SITE.ownerName, name: SITE.name })}
    >
      Hi, I'm {SITE.ownerName} — I built {SITE.name} to be the tool I wanted:
      fast, free, and private. Everything runs in your browser. Your data stays on
      your device. Exports are generated on your machine.
    </p>

    <ul
      class="value-list"
      aria-label="Product principles"
      data-i18n-attrs="aria-label:marketing.about.principles"
    >
      {values.map((v) => <li data-i18n={v.key}>{v.label}</li>)}
    </ul>

    <div class="prose">
      <h2 data-i18n="marketing.about.shortTitle">The short version</h2>
      <p data-i18n="marketing.about.shortBody">
        No account. No uploads. No tracking, no ads, no paywalls — and nothing
        gated behind “free until you export.” Offered as-is, because a resume
        tool should respect your time and your privacy.
      </p>
      <p>
        <span data-i18n="marketing.about.privacyPrefix">The </span><a
          href="/privacy"
          data-i18n="marketing.about.privacyLink">privacy page</a
        ><span data-i18n="marketing.about.privacyMiddle">
          covers where every byte goes (nowhere, unless you ask).
        </span> <a href="/features" data-i18n="marketing.about.featuresLink">Features</a
        ><span data-i18n="marketing.about.featuresMiddle">
          shows what it can do — including optional AI, which only talks to a
          provider you configure yourself.
        </span>
      </p>
    </div>

    <h2 class="page-section" id="support" data-i18n="marketing.about.supportTitle">Get support</h2>
    <div class="grid support-grid">
      <article class="card">
        <h3 data-i18n="marketing.about.questionsTitle">Questions &amp; feedback</h3>
        <p data-i18n="marketing.about.questionsBody">
          Something unclear, or you have an idea? Email me directly — I read
          everything.
        </p>
        <a class="btn btn-secondary" href={`mailto:${SITE.email}`}>
          {SITE.email}
        </a>
      </article>
      <article class="card">
        <h3 data-i18n="marketing.about.bugsTitle">Bugs &amp; issues</h3>
        <p data-i18n="marketing.about.bugsBody">
          When something breaks, include steps to reproduce and what you
          expected. Everything runs locally — I can't see your resumes.
        </p>
        <a class="btn btn-secondary" href={`mailto:${SITE.email}`}>
          <span data-i18n="marketing.about.reportIssue">Report an issue</span>
        </a>
      </article>
    </div>

    <div class="coffee">
      <div class="coffee-copy">
        <h2 data-i18n="marketing.about.coffeeTitle">Liked it? Buy me a coffee</h2>
        <p data-i18n="marketing.about.coffeeBody">
          {SITE.name} is free forever — no ads, no paid exports, nothing gated.
          If it saved you time, a coffee is an optional way to say thanks.
        </p>
        <a
          class="btn btn-primary"
          href={SITE.bmcUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span data-i18n="marketing.about.coffeeButton">Buy me a coffee</span>
        </a>
      </div>
      <a
        class="coffee-qr"
        href={SITE.bmcUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Scan the QR code to buy me a coffee"
        data-i18n-attrs="aria-label:marketing.about.qrLabel"
      >
        <img
          src={SITE.bmcQr}
          alt={`QR code to ${SITE.bmcUrl}`}
          data-i18n-attrs="alt:marketing.about.qrAlt"
          width="200"
          height="200"
          loading="lazy"
        />
      </a>
    </div>
  </section>

  <section class="cta-band reveal">
    <div class="container">
      <h2 data-i18n="marketing.about.ctaTitle">Give it a spin</h2>
      <p data-i18n="marketing.about.ctaBody">Free, local, and yours — your first resume is minutes away.</p>
      <a class="btn btn-primary" href="/resumes" data-i18n="marketing.about.ctaButton">Start building free</a>
    </div>
  </section>
</MarketingLayout>

<style>
  .value-list {
    list-style: none;
    margin: 0 0 var(--spacing-8);
    padding: 0;
    display: grid;
    gap: var(--spacing-2);
    border-top: 1px solid var(--color-border);
  }

  .value-list li {
    padding: var(--spacing-2) 0;
    border-bottom: 1px solid var(--color-border);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text-primary);
  }

  .page-section {
    text-align: left;
    margin: var(--spacing-8) 0 var(--spacing-4);
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    letter-spacing: -0.015em;
    font-weight: 700;
  }

  .support-grid {
    margin-bottom: var(--spacing-8);
  }

  .support-grid .card {
    gap: var(--spacing-3);
  }

  .support-grid .btn {
    align-self: flex-start;
  }

  .coffee {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-container);
    background: var(--color-background-card);
    padding: var(--spacing-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-8);
  }

  .coffee-copy h2 {
    margin: 0 0 var(--spacing-2);
    font-size: 1.45rem;
    letter-spacing: -0.015em;
  }

  .coffee-copy p {
    margin: 0 0 var(--spacing-5);
    color: var(--color-text-secondary);
    font-size: 0.98rem;
    max-width: 34em;
  }

  .coffee-qr {
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-element);
    background: var(--color-background-body);
    padding: var(--spacing-2);
    display: inline-grid;
    place-items: center;
    transition: opacity 150ms ease;
  }

  .coffee-qr:hover {
    opacity: 0.9;
  }

  .coffee-qr img {
    display: block;
    width: 200px;
    height: 200px;
  }

  @media (max-width: 720px) {
    .coffee {
      flex-direction: column-reverse;
      align-items: center;
      text-align: center;
    }
  }
</style>
