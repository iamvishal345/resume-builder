---
import MarketingLayout from "../layouts/MarketingLayout.astro";
---

<MarketingLayout
  title="Page not found"
  description="The page you were looking for doesn't exist or has moved."
  noindex
>
  <section class="hero">
    <h1>404 — page not found</h1>
    <p>
      The page you're after doesn't exist, or it moved during a refresh. Your
      resume, though — that's still exactly where you left it.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/resumes">Go to my resumes</a>
      <a class="btn btn-secondary" href="/">Back to home</a>
    </div>
  </section>
</MarketingLayout>