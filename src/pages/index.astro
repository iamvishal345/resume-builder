---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import FeatureIcon from "../components/marketing/FeatureIcon.astro";
import { SITE } from "../data/site";

const features = [
  {
    icon: "download",
    title: "One-click export",
    description:
      "Export a pixel-perfect PDF or a Word .docx straight from the same live preview you see on screen.",
  },
  {
    icon: "upload",
    title: "Import from PDF or DOCX",
    description:
      "Already have a resume? Upload your current PDF, Word document, or backup file and start from your writing, not a blank page.",
  },
  {
    icon: "roadmap",
    title: "Live preview & themes",
    description:
      "Swap templates, accent colors, and typefaces and watch the preview update instantly as you type.",
  },
  {
    icon: "sparkles",
    title: "AI first draft",
    description:
      "Type a job title and get a believable starting point — summary, highlights, and skills — ready for you to make your own.",
  },
  {
    icon: "clipboard",
    title: "Resume check & job match",
    description:
      "Run an at-a-glance score plus a coherence pass — overlapping dates, duplicated contacts, unsupported claims — before you send it.",
  },
  {
    icon: "lock",
    title: "Private by default",
    description:
      "Everything is saved in your browser. No account, no uploads, no tracking. Back up and restore with a file you own.",
  },
];

const steps = [
  {
    title: "Write guided",
    description:
      "Six focused steps — details, work, education, skills, summary, extras — with drag-and-drop reordering and rich-text editing.",
  },
  {
    title: "Check & polish",
    description:
      "A live resume score and a coherence pass flag overlaps, duplicates, and unsupported claims before a recruiter ever sees them.",
  },
  {
    title: "Export & send",
    description:
      "Download a PDF or DOCX that matches the preview exactly, or paste a job description into Job match to tailor your wording.",
  },
];
---

<MarketingLayout
  title={SITE.tagline}
  description={SITE.description}
  ogTitle="Cavren — offline, free, private resume builder with PDF & DOCX export"
>
  <section class="hero">
    <p class="hero-brand">
      <img src="/logo.svg" alt="" height="40px" />
    </p>
    <h1>
      Build a resume that gets <br />
      <span class="grad">you hired</span>
    </h1>
    <p>
      A fast, free, and fully private resume builder. Fill in guided
      sections, keep a live preview on screen, and export a clean PDF or DOCX
      in minutes — no sign-up, no uploads, no tracking.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/resumes">Start building free</a>
      <a class="btn btn-secondary" href="/features">See features</a>
    </div>
  </section>

  <section class="container">
    <div class="section-title">
      <h2>From blank page to PDF in minutes</h2>
      <p>A guided path that keeps a polished preview beside every step.</p>
    </div>
    <div class="grid grid-3">
      {steps.map((step, index) => (
        <article class="card">
          <h3>{index + 1} · {step.title}</h3>
          <p>{step.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container cards-pad">
    <div class="section-title">
      <h2>Everything you need, nothing you don't</h2>
      <p>Optimized for the way people actually build resumes today.</p>
    </div>
    <div class="grid">
      {features.map((feature) => (
        <article class="card">
          <span class="icon">
            <FeatureIcon name={feature.icon} />
          </span>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>Ready to give your career a refresh?</h2>
      <p>Your data stays local. Your best resume is a few minutes away.</p>
      <a class="btn btn-primary" href="/resumes">Build your resume now</a>
    </div>
  </section>
</MarketingLayout>

<style>
  .grad {
    background: linear-gradient(
      90deg,
      var(--color-accent),
      color-mix(in srgb, var(--color-accent) 55%, var(--color-background-surface))
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .cards-pad {
    padding-block: var(--spacing-10) var(--spacing-12);
  }
</style>