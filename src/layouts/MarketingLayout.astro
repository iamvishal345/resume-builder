---
import Layout from "./Layout.astro";
import SiteNav from "../components/marketing/SiteNav.astro";
import SiteFooter from "../components/marketing/SiteFooter.astro";
import { t } from "../features/i18n";
import "../styles/marketing.css";

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: "website" | "article";
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  titleKey?: string;
  descriptionKey?: string;
  ogTitleKey?: string;
  ogDescriptionKey?: string;
  i18nVars?: Record<string, string>;
}

const props = Astro.props as Props;
---

<Layout
  title={props.title}
  description={props.description}
  ogTitle={props.ogTitle}
  ogDescription={props.ogDescription}
  ogType={props.ogType}
  canonical={props.canonical}
  noindex={props.noindex}
  ogImage={props.ogImage}
  titleKey={props.titleKey}
  descriptionKey={props.descriptionKey}
  ogTitleKey={props.ogTitleKey}
  ogDescriptionKey={props.ogDescriptionKey}
  i18nVars={props.i18nVars}
>
  <a
    class="skip-link"
    href="#main"
    data-i18n="a11y.skip"
  >{t("a11y.skip")}</a>
  <SiteNav />
  <main id="main">
    <slot />
  </main>
  <SiteFooter />
</Layout>

<script>
  import {
    applyDocumentLocale,
    getLocale,
    setLocale,
    subscribeLocale,
    t,
  } from "@features/i18n";

  const varsFor = (element) => {
    const value = element.getAttribute("data-i18n-vars");
    if (!value) return undefined;
    try {
      return JSON.parse(value);
    } catch {
      return undefined;
    }
  };

  const syncText = () => {
    document.querySelectorAll("[data-i18n]").forEach((element) => {
      const key = element.getAttribute("data-i18n");
      if (!key) return;
      const suffix = element.getAttribute("data-i18n-suffix") || "";
      element.textContent = `${t(key, varsFor(element))}${suffix}`;
    });

    document.querySelectorAll("[data-i18n-attrs]").forEach((element) => {
      const value = element.getAttribute("data-i18n-attrs");
      if (!value) return;
      value.split(";").forEach((entry) => {
        const separator = entry.indexOf(":");
        if (separator < 1) return;
        const attribute = entry.slice(0, separator).trim();
        const key = entry.slice(separator + 1).trim();
        if (attribute && key) {
          element.setAttribute(attribute, t(key, varsFor(element)));
        }
      });
    });

    applyDocumentLocale();
    const select = document.getElementById("cavren-locale");
    if (select instanceof HTMLSelectElement) select.value = getLocale();
  };

  const start = () => syncText();
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start, { once: true });
  } else {
    start();
  }
  document.addEventListener("astro:page-load", start);
  subscribeLocale(start);

  document.addEventListener("change", (event) => {
    const target = event.target;
    if (target instanceof HTMLSelectElement && target.id === "cavren-locale") {
      setLocale(target.value);
    }
  });
</script>

<style>
  .skip-link {
    position: absolute;
    left: var(--spacing-3);
    top: -100vh;
    z-index: 100;
    padding: var(--spacing-2) var(--spacing-3);
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-radius: var(--radius-element);
    text-decoration: none;
    font-weight: 600;
  }

  .skip-link:focus-visible {
    top: var(--spacing-3);
  }
</style>
