---
import "../styles/global.css";
import { SITE } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  /** Open Graph / Twitter card title (defaults to `title`). */
  ogTitle?: string;
  /** Open Graph description (defaults to `description`). */
  ogDescription?: string;
  ogType?: "website" | "article";
  /** Canonical URL. Defaults to SITE.url + current path. */
  canonical?: string;
  /** Set true for pages that should never be indexed (e.g. 404). */
  noindex?: boolean;
  /** Open Graph image. Defaults to the site's shared card. */
  ogImage?: string;
}

const {
  title = SITE.name,
  description = SITE.description,
  ogTitle = title,
  ogDescription = description,
  ogType = "website",
  noindex = false,
  ogImage = SITE.ogImage,
} = Astro.props;

const canonical =
  Astro.url.pathname === "/"
    ? `${SITE.url}/`
    : `${SITE.url}${Astro.url.pathname.replace(/\/+$/, "")}/`;

const fullOgImage = `${SITE.url}${ogImage}`;
const fullTitle = `${title} · ${SITE.name}`;
---

<!doctype html>
<html lang="en" data-astryx-theme="matcha">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="theme-color" content="#4b7a57" />
    <meta name="mobile-web-app-capable" content="yes" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={fullOgImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={fullOgImage} />

    <script is:inline>
      (function () {
        var key = "rb-theme";
        var doc = document.documentElement;
        var mq = window.matchMedia("(prefers-color-scheme: dark)");
        function scheme(mode) {
          if (mode === "dark") return "dark";
          if (mode === "light") return "light";
          return mq.matches ? "dark" : "light";
        }
        function applyTheme(mode, persist) {
          var resolved = scheme(mode);
          doc.dataset.theme = resolved;
          var meta = document.querySelector('meta[name="color-scheme"]');
          if (meta) meta.content = resolved;
          if (persist) {
            if (mode === "system") localStorage.removeItem(key);
            else localStorage.setItem(key, mode);
          }
        }
        window.__setTheme = function (mode) {
          applyTheme(mode, mode !== "system");
        };
        window.__toggleTheme = function () {
          var next = doc.dataset.theme === "dark" ? "light" : "dark";
          applyTheme(next, true);
          return next;
        };
        applyTheme(localStorage.getItem(key) || "system", false);
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      import "../pwa.ts";
    </script>
  </body>
</html>