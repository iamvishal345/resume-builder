---
import ThemeToggle from "../ThemeToggle.astro";
import LocaleSelect from "../LocaleSelect";
import { SITE } from "@data/site";
import { t } from "@features/i18n";
---

<header class="site-nav">
  <div class="container">
    <a
      class="brand"
      href="/"
      aria-label={t("nav.home")}
      data-i18n-attrs="aria-label:nav.home"
    >
      <img src="/logo.svg" alt="" height="40" width="40" />
    </a>
    <nav aria-label="Primary" data-i18n-attrs="aria-label:marketing.nav.primary">
      <a href="/features" data-i18n="nav.features">{t("nav.features")}</a>
      <a href="/about" data-i18n="nav.about">{t("nav.about")}</a>
      <a href="/privacy" data-i18n="nav.privacy">{t("nav.privacy")}</a>
      <LocaleSelect client:load />
      <ThemeToggle />
      <a class="cta" href="/resumes" data-i18n="nav.start">{t("nav.start")}</a>
    </nav>
  </div>
</header>
