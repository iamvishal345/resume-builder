---
import { SITE } from "@data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/" aria-label={`${SITE.name} home`}>
          <img src="/logo.svg" alt="" height="32" width="32" />
        </a>
        <p>
          Free, private resume builder — guided editing, live preview, and honest
          exports. Your data never leaves your browser unless you choose.
        </p>
      </div>
      <div>
        <h3>Product</h3>
        <ul>
          <li><a href="/features">Features</a></li>
          <li><a href="/resumes">My resumes</a></li>
          <li><a href="/features#export">Export</a></li>
        </ul>
      </div>
      <div>
        <h3>Learn</h3>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href="/about#support">Support</a></li>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
      <div>
        <h3>Start</h3>
        <ul>
          <li><a href="/resumes">Build a resume</a></li>
          <li><a href="/features#ai">AI drafting</a></li>
          <li>
            <a href={SITE.bmcUrl} target="_blank" rel="noopener noreferrer"
              >Buy me a coffee</a
            >
          </li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span
        >© {year}
        {SITE.legalName} · Private by design · No trackers · No ads</span
      >
      <nav aria-label="Footer">
        <a href="/privacy">Privacy</a>
        <a href="/contact">Contact</a>
      </nav>
    </div>
  </div>
</footer>
