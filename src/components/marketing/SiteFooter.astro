---
import { SITE } from "@data/site";
import { t } from "@features/i18n";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a
          class="brand"
          href="/"
          aria-label={t("nav.home")}
          data-i18n-attrs="aria-label:nav.home"
        >
          <img src="/logo.svg" alt="" height="32" width="32" />
        </a>
        <p data-i18n="footer.blurb">{t("footer.blurb")}</p>
      </div>
      <div>
        <h3 data-i18n="footer.product">{t("footer.product")}</h3>
        <ul>
          <li><a href="/features" data-i18n="footer.features">{t("footer.features")}</a></li>
          <li><a href="/resumes" data-i18n="footer.resumes">{t("footer.resumes")}</a></li>
          <li><a href="/features#export" data-i18n="footer.export">{t("footer.export")}</a></li>
        </ul>
      </div>
      <div>
        <h3 data-i18n="footer.learn">{t("footer.learn")}</h3>
        <ul>
          <li><a href="/about" data-i18n="footer.about">{t("footer.about")}</a></li>
          <li><a href="/about#support" data-i18n="footer.support">{t("footer.support")}</a></li>
          <li><a href="/privacy" data-i18n="footer.privacy">{t("footer.privacy")}</a></li>
          <li><a href="/contact" data-i18n="footer.contact">{t("footer.contact")}</a></li>
        </ul>
      </div>
      <div>
        <h3 data-i18n="footer.start">{t("footer.start")}</h3>
        <ul>
          <li><a href="/resumes" data-i18n="footer.build">{t("footer.build")}</a></li>
          <li><a href="/features#ai" data-i18n="footer.ai">{t("footer.ai")}</a></li>
          <li>
            <a
              href={SITE.bmcUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-i18n="footer.coffee"
              >{t("footer.coffee")}</a
            >
          </li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>
        © {year} {SITE.legalName} ·
        <span data-i18n="marketing.footer.legal">Private by design · No trackers · No ads</span>
      </span>
      <nav aria-label="Footer" data-i18n-attrs="aria-label:marketing.nav.footer">
        <a href="/privacy" data-i18n="footer.privacy">{t("footer.privacy")}</a>
        <a href="/contact" data-i18n="footer.contact">{t("footer.contact")}</a>
      </nav>
    </div>
  </div>
</footer>
