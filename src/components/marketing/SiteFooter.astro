---
import { SITE } from "@data/site";
import { t, resolveRequestLocale } from "@features/i18n";

resolveRequestLocale(Astro.cookies.get("cavren-locale")?.value);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/" aria-label={t("nav.home")}>
          <img src="/logo.svg" alt="" height="32" width="32" />
          <span>{SITE.name}</span>
        </a>
        <p>{t("footer.blurb")}</p>
      </div>
      <div>
        <h3>{t("footer.product")}</h3>
        <ul>
          <li><a href="/features">{t("footer.features")}</a></li>
          <li><a href="/resumes">{t("footer.resumes")}</a></li>
          <li><a href="/features#export">{t("footer.export")}</a></li>
        </ul>
      </div>
      <div>
        <h3>{t("footer.learn")}</h3>
        <ul>
          <li><a href="/about">{t("footer.about")}</a></li>
          <li><a href="/about#support">{t("footer.support")}</a></li>
          <li><a href="/privacy">{t("footer.privacy")}</a></li>
          <li><a href="/contact">{t("footer.contact")}</a></li>
        </ul>
      </div>
      <div>
        <h3>{t("footer.start")}</h3>
        <ul>
          <li><a href="/resumes">{t("footer.build")}</a></li>
          <li><a href="/features#ai">{t("footer.ai")}</a></li>
          <li>
            <a href={SITE.bmcUrl} target="_blank" rel="noopener noreferrer"
              >{t("footer.coffee")}</a
            >
          </li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span
        >© {year}
        {SITE.legalName} · Private by design · No trackers · No ads</span
      >
      <nav aria-label="Footer">
        <a href="/privacy">{t("footer.privacy")}</a>
        <a href="/contact">{t("footer.contact")}</a>
      </nav>
    </div>
  </div>
</footer>
